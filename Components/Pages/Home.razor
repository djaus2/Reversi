@page "/"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@* @attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Player,Admin")]
 *@
@using Reversi.Services
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Nav
@inject SettingsService Settings
@inject AuthenticationStateProvider AuthStateProvider
@inject Microsoft.JSInterop.IJSRuntime JSRuntime
@inject IHttpContextAccessor HttpContextAccessor

<PageTitleHeading Title="@($"Reversi online V{Version}")" HeadingLevel="2" />

<br />

<p>Play Reversi (Othello) with a friend online — place discs to flip your opponent's pieces; most discs at the end wins!</p>

@if (!_isAuthenticated)
{
    <a href="/login" role="button" style="display:inline-block;padding:6px 12px;border-radius:4px;border:1px solid #888;background:#f3f3f3;color:inherit;text-decoration:none;">Login to start or join a Game</a>
}
else
{
    <a href="@(_isAdmin ? "/admin" : "/player")" role="button" style="display:inline-block;padding:6px 12px;border-radius:4px;border:1px solid #888;background:#f3f3f3;color:inherit;text-decoration:none;">Continue</a>
}

<br />

<div style="max-width:400px;padding:12px;border:1px solid #ccc;background-color:lightgreen;">
    <h4 style="margin-top:0;"><font color="blue">Game Timeout Settings</font></h4>
    <div style="font-size:14px;line-height:1.6;">
        <div><strong>Move timeout:</strong> @_maxMoveTimeoutMins minutes</div>
        <div><strong>Max game time:</strong> @_maxGameTimeMins minutes</div>
        <div><strong>Max game start wait:</strong> @_maxGameStartWaitTimeMins minutes</div>
        <div><strong>Max login session:</strong> @_maxLoginHrs hours</div>
    </div>
</div>

<div style="max-width:400px;padding:12px;border:1px solid #ccc;background-color:beige">
    <h4 style="margin-top:0;"><font color="purple">Players and Playing</font></h4>
    <div style="font-size:14px;line-height:1.6;">
        <div><strong>Players: </strong>Bob, Ted, Carol and Alice </div>
        <div><strong>Pin for login: </strong>All pins are 9999</div>
        <div><strong>Group Bob-Carol: </strong>Bob and Carol can play</div>
        <div><strong>Group Ted-Alice: </strong>Ted and Alice can play</div>
        <div><strong><i>One starts the game, other joins</i></strong> </div>
        <div><strong><i>Note timeouts as above</i></strong> </div>
        <div><strong><i>New: </i><font color="red">Fred,John,Harry,Mary,Sue,Libby</font> all in <font color="purple">Global</font> Group</strong></div>
    </div>
</div>

<div style="max-width:400px;padding:12px;border:1px solid #ccc;background-color:pink">
    <h4 style="margin-top:0;"><font color="purple">Play against AI!</font></h4>
    <div style="font-size:14px;line-height:1.6;">
        <div><strong>Select Play against AI</strong>&nbsp;Then select AI Mode:</div>
        <div><strong>- Random: </strong>AI is quite dumb!</div>
        <div><strong>- Easy: </strong>AI avoids handing you corners</div>
        <div><strong>- Moderate-3-ply: </strong>AI maximises its positional gain each move</div>
        <div><strong>- Hard: </strong>AI looks 3 plies ahead with positional evaluation</div>
        <div><strong><i>Player starts the game, AI joins automatically</i></strong> </div>
    </div>
</div>

@code{
    private int _maxMoveTimeoutMins = 5;
    private int _maxGameTimeMins = 30;
    private int _maxGameStartWaitTimeMins = 30;
    private int _maxLoginHrs = 4;
    private bool _isAuthenticated = false;
    private bool _isAdmin = false;

    protected override async Task OnInitializedAsync()
    {
        _maxMoveTimeoutMins = await Settings.GetMaxMoveTimeoutMinsAsync();
        _maxGameTimeMins = await Settings.GetMaxGameTimeMinsAsync();
        _maxGameStartWaitTimeMins = await Settings.GetMaxGameStartWaitTimeMinsAsync();
        _maxLoginHrs = await Settings.GetMaxLoginHrsAsync();

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        _isAuthenticated = user?.Identity?.IsAuthenticated == true;
        _isAdmin = _isAuthenticated && user!.IsInRole("Admin");
    }

    private string Version 
    {
        get
        {
            try
            {
                // Read version from auth.json
                var jsonPath = Path.Combine(Directory.GetCurrentDirectory(), "auth.json");
                if (File.Exists(jsonPath))
                {
                    var jsonContent = File.ReadAllText(jsonPath);
                    using var document = JsonDocument.Parse(jsonContent);
                    if (document.RootElement.TryGetProperty("version", out var versionElement))
                    {
                        return versionElement.GetString() ?? "7.0.0";
                    }
                }
            }
            catch
            {
                // Fallback if JSON reading fails
            }
            return "7.0.0"; // Fallback version
        }
    }

}
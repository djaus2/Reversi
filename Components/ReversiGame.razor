    private async Task CancelOrExitGame()
    {
        if (_game is null)
        {
            await Task.CompletedTask;
            return;
        }

        if (_game.State == ReversiService.GameState.Finished || _game.State == ReversiService.GameState.Abandoned)
        {
            // Game is finished - dispose of it properly by removing it
            if (!string.IsNullOrWhiteSpace(_gameId))
            {
                Console.WriteLine($"[ReversiGame] Exiting finished game {_gameId}, removing from active games");
                GameService.RemoveGame(_gameId);
                Console.WriteLine($"[ReversiGame] Game {_gameId} removed");
            }
            
            Nav.NavigateTo(_isAdmin ? "/admin" : "/player", forceLoad: true);
            await Task.CompletedTask;
            return;
        }

        // Show confirmation dialog for active games
        _showCancelConfirm = true;
        await InvokeAsync(StateHasChanged);
    }


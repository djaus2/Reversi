    private async Task OnCellClick(int r, int c)
    {
        if (!CanInteractWithBoard())
        {
            if (_game is not null && _game.State == ReversiService.GameState.Finished)
            {
                _message = GameResultText;
            }
            else if (_game is not null && _game.State == ReversiService.GameState.Abandoned)
            {
                _message = "Game was abandoned.";
            }
            await InvokeAsync(StateHasChanged);
            return;
        }

        if (_game == null)
        {
            _message = "No game loaded.";
            await InvokeAsync(StateHasChanged);
            return;
        }

        if (_game.Board[r, c] != 0)
        {
            _message = $"Square ({r},{c}) is already occupied.";
            await InvokeAsync(StateHasChanged);
            return;
        }

        (bool ok, string? msg) result;
        if (IsAdminControllingGame())
        {
            result = GameService.MakeMoveAsAdmin(_gameId!, r, c);
        }
        else
        {
            if (_game.CurrentTurn != _playerNumber)
            {
                _message = $"Not your turn - {ColorName(_game.CurrentTurn)} to move.";
                await InvokeAsync(StateHasChanged);
                return;
            }
            result = GameService.MakeMove(_gameId!, _playerNumber, r, c);
        }

        var (ok, msg) = result;
        _message = ok ? "" : msg ?? "Invalid move";

        if (ok && !string.IsNullOrWhiteSpace(_gameId))
        {
            _game = GameService.GetGame(_gameId);
        }

        RefreshLegalMoves();
        await InvokeAsync(StateHasChanged);
    }

    private bool IsAdminControllingGame()
    {
        return _isAdmin && _game is not null && _game.AdminMode;
    }

    private void RefreshLegalMoves()
    {
        _legalMoves.Clear();
        if (_game is null || string.IsNullOrWhiteSpace(_gameId)) return;
        if (_game.State == ReversiService.GameState.Finished || _game.State == ReversiService.GameState.Abandoned) return;

        // Show placement hints to the side to move (admin sees the side to move).
        var playerToMove = _game.CurrentTurn;
        if (!IsAdminControllingGame() && playerToMove != _playerNumber) return;

        foreach (var m in GameService.ListLegalMoves(_gameId, playerToMove))
        {
            _legalMoves.Add((m.R, m.C));
        }
    }

    private static string ColorName(int player)
    {
        return player switch
        {
            1 => "Black",
            2 => "White",
            _ => "?"
        };
    }

    private bool CanInteractWithBoard()
    {
        if (!_connected) return false;
        if (_game is null) return false;
        if (_aiMoveInProgress) return false;
        if (_isBoardFlipAnimationRunning) return false;
        if (_game.State == ReversiService.GameState.Finished || _game.State == ReversiService.GameState.Abandoned) return false;
        if (_game.AdminMode && !_isAdmin) return false;
        return true;
    }

    private int GetDisplayedCell(int r, int c)
    {
        if (_displayBoardInitialized)
        {
            return _displayBoard[r, c];
        }

        return _game is null ? 0 : _game.Board[r, c];
    }

    private bool IsAnimatingFlipSquare(int r, int c)
    {
        return _animatingFlipSquares.Contains((r, c));
    }

    private void InitializeDisplayBoardFromGame()
    {
        if (_game is null)
        {
            _displayBoardInitialized = false;
            _animatingFlipSquares.Clear();
            return;
        }

        CopyBoard(_game.Board, _displayBoard);
        _displayBoardInitialized = true;
        _animatingFlipSquares.Clear();
        _isBoardFlipAnimationRunning = false;
    }

    private void ScheduleFlipAnimation()
    {
        if (_game is null)
        {
            _displayBoardInitialized = false;
            _animatingFlipSquares.Clear();
            _isBoardFlipAnimationRunning = false;
            return;
        }

        var targetBoard = CloneBoard(_game.Board);
        var delay = TimeSpan.FromMilliseconds(Math.Clamp(_aiMoveDelaySeconds, 50, 10000));
        var flippedSquares = _game.LastMoveFlippedSquares
            .Select(p => (p.R, p.C))
            .Where(p => p.R >= 0 && p.R < 8 && p.C >= 0 && p.C < 8)
            .Distinct()
            .ToList();

        var moveTo = (_game.LastMoveToR.HasValue && _game.LastMoveToC.HasValue)
            ? (_game.LastMoveToR.Value, _game.LastMoveToC.Value)
            : ((int R, int C)?)null;

        _flipAnimationCts?.Cancel();
        _flipAnimationCts?.Dispose();
        _flipAnimationCts = new CancellationTokenSource();
        var token = _flipAnimationCts.Token;
        var runId = ++_flipAnimationRunId;

        _ = AnimateFlipsAsync(targetBoard, flippedSquares, moveTo, delay, token, runId);
    }

    private async Task AnimateFlipsAsync(
        int[,] targetBoard,
        List<(int R, int C)> flippedSquares,
        (int R, int C)? moveTo,
        TimeSpan perFlipDelay,
        CancellationToken token,
        int runId)
    {
        try
        {
            if (!_displayBoardInitialized)
            {
                CopyBoard(targetBoard, _displayBoard);
                _displayBoardInitialized = true;
                await InvokeAsync(StateHasChanged);
                return;
            }

            if (moveTo.HasValue)
            {
                var (mr, mc) = moveTo.Value;
                if (mr >= 0 && mr < 8 && mc >= 0 && mc < 8)
                {
                    _displayBoard[mr, mc] = targetBoard[mr, mc];
                }
            }

            var sequence = flippedSquares
                .Where(p => _displayBoard[p.R, p.C] != targetBoard[p.R, p.C])
                .ToList();

            if (sequence.Count == 0)
            {
                CopyBoard(targetBoard, _displayBoard);
                _animatingFlipSquares.Clear();
                if (runId == _flipAnimationRunId)
                {
                    _isBoardFlipAnimationRunning = false;
                }
                await InvokeAsync(StateHasChanged);
                if (CanRunAiMove())
                {
                    _ = RunAiMoveAsync();
                }
                return;
            }

            _isBoardFlipAnimationRunning = true;

            foreach (var (r, c) in sequence)
            {
                token.ThrowIfCancellationRequested();

                _displayBoard[r, c] = targetBoard[r, c];
                _animatingFlipSquares.Clear();
                _animatingFlipSquares.Add((r, c));
                await InvokeAsync(StateHasChanged);

                await Task.Delay(TimeSpan.FromMilliseconds(420), token);

                _animatingFlipSquares.Clear();
                await InvokeAsync(StateHasChanged);

                await Task.Delay(perFlipDelay, token);
            }

            CopyBoard(targetBoard, _displayBoard);
            _animatingFlipSquares.Clear();
            if (runId == _flipAnimationRunId)
            {
                _isBoardFlipAnimationRunning = false;
            }
            await InvokeAsync(StateHasChanged);

            if (CanRunAiMove())
            {
                _ = RunAiMoveAsync();
            }
        }
        catch (OperationCanceledException)
        {
        }
        finally
        {
            _animatingFlipSquares.Clear();
            if (runId == _flipAnimationRunId)
            {
                _isBoardFlipAnimationRunning = false;
            }
        }
    }

    private static int[,] CloneBoard(int[,] source)
    {
        var clone = new int[8, 8];
        CopyBoard(source, clone);
        return clone;
    }

    private static void CopyBoard(int[,] source, int[,] destination)
    {
        for (var r = 0; r < 8; r++)
        {
            for (var c = 0; c < 8; c++)
            {
                destination[r, c] = source[r, c];
            }
        }
    }

    private bool IsAiPreviewCell(int r, int c)
    {
        if (!_aiPreviewMove.HasValue) return false;
        return _aiPreviewMove.Value.R == r && _aiPreviewMove.Value.C == c;
    }

    private bool CanRunAiMove()
    {
        if (!_isAiMode) return false;
        if (_aiMoveInProgress) return false;
        if (_isBoardFlipAnimationRunning) return false;
        if (_game is null) return false;
        if (string.IsNullOrWhiteSpace(_gameId)) return false;
        if (_game.CurrentTurn != 2) return false;
        return _game.State == ReversiService.GameState.Connected || _game.State == ReversiService.GameState.Playing;
    }

    private async Task RunAiMoveAsync()
    {
        if (!CanRunAiMove()) return;

        _aiMoveInProgress = true;
        try
        {
            var flipDelayMs = Math.Clamp(_aiMoveDelaySeconds, 50, 10000);
            var multiplier = Math.Clamp(_aiPlayDelayMultiplier, 1, 10);
            var aiPlayDelayMs = Math.Clamp(flipDelayMs * multiplier, 50, 60000);
            var aiPlayDelay = TimeSpan.FromMilliseconds(aiPlayDelayMs);
            var flipDelay = TimeSpan.FromMilliseconds(flipDelayMs);

            await Task.Delay(aiPlayDelay);

            if (_game is null || string.IsNullOrWhiteSpace(_gameId) || _game.CurrentTurn != 2)
            {
                return;
            }

            var (success, message, r, c) = AiService.SelectMove(_gameId!, 2, _aiDifficultyLevel);
            if (!success || !r.HasValue || !c.HasValue)
            {
                _message = $"AI move failed: {message}";
                return;
            }

            _aiPreviewMove = (r.Value, c.Value);
            var difficultyText = _aiDifficultyLevel switch { 0 => "Easy", 1 => "Moderate", 2 => "Hard", 3 => "Random", _ => "Moderate" };
            _message = $"AI ({difficultyText}) placed at {r},{c}";
            await InvokeAsync(StateHasChanged);

            await Task.Delay(flipDelay);

            if (_game is null || string.IsNullOrWhiteSpace(_gameId) || _game.CurrentTurn != 2)
            {
                return;
            }

            var (applied, applyMessage) = GameService.MakeMove(_gameId!, 2, r.Value, c.Value);
            if (applied)
            {
                _game = GameService.GetGame(_gameId!);
                RefreshLegalMoves();
            }
            else
            {
                _message = $"AI move failed: {applyMessage}";
            }
        }
        finally
        {
            _aiPreviewMove = null;
            _aiMoveInProgress = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private bool IsLastMoveTo(int r, int c)
    {
        if (_game is null) return false;
        if (!_game.LastMoveToR.HasValue || !_game.LastMoveToC.HasValue) return false;
        return _game.LastMoveToR.Value == r && _game.LastMoveToC.Value == c;
    }

    private bool IsLastMoveFlipped(int r, int c)
    {
        if (_game is null) return false;
        if (_game.LastMoveFlippedSquares.Count == 0) return false;
        return _game.LastMoveFlippedSquares.Any(p => p.R == r && p.C == c);
    }

    private void DismissGameOverOverlay()
    {
        _showGameOverOverlay = false;

        // Acknowledge the result and keep the finished board visible.
        if (_game?.State == ReversiService.GameState.Finished)
        {
            _gameOverAcknowledged = true;
        }
    }

    private void StartNewGame()
    {
        // Clear any existing game state
        ClearGameState();
        
        // Start new game with same settings as current game
        if (_isAiMode)
        {
            // Start AI game with same difficulty level
            Nav.NavigateTo($"/Reversi?ai=true&aiDifficulty={_aiDifficultyLevel}", forceLoad: true);
        }
        else
        {
            // For multiplayer games, go to player page to select group/settings
            Nav.NavigateTo("/player", forceLoad: true);
        }
    }

    private void ClearGameState()
    {
        Console.WriteLine($"[ReversiGame] ClearGameState called - clearing game state. Current gameId: {_gameId}");
        
        _gameId = null;
        _game = null;
        _playerNumber = 0;
        _connected = false;
        _joined = false;
        _status = "";
        _message = "";
        _legalMoves.Clear();
        _showGameOverOverlay = false;
        _gameOverAcknowledged = false;
        _gameEndedWithWinLoss = false;
        _gameClosedReason = null;
        _lastGameState = ReversiService.GameState.New;
        _lastWinnerPlayer = null;
        _lastChatCount = 0;
        _chatDisplayStartIndex = 0;
        _chatScrollPending = false;
        _showCancelConfirm = false;
        _showConcedeConfirm = false;
        _aiMoveInProgress = false;
        _aiPreviewMove = null;
        _isBoardFlipAnimationRunning = false;
        _animatingFlipSquares.Clear();
        _displayBoardInitialized = false;
        _flipAnimationRunId++;

        try
        {
            _flipAnimationCts?.Cancel();
            _flipAnimationCts?.Dispose();
            _flipAnimationCts = null;
        }
        catch
        {
        }
        
        Console.WriteLine("[ReversiGame] Game state cleared - all variables reset");
        
        // Clear UI timer
        try
        {
            _uiTimer?.Dispose();
            _uiTimer = null;
            Console.WriteLine("[ReversiGame] UI timer disposed");
        }
        catch
        {
        }
        
        // Unsubscribe from game updates
        try
        {
            GameService.GameUpdated -= OnGameUpdated;
        }
        catch
        {
        }
    }

    private void OnCellRightClick(MouseEventArgs e, int r, int c)
    {
        if (!IsAdminControllingGame()) return;
        if (string.IsNullOrWhiteSpace(_gameId)) return;

        var (ok, msg) = GameService.DeletePieceAsAdmin(_gameId!, r, c);
        _message = ok ? "" : msg ?? "Delete failed";
        _ = InvokeAsync(StateHasChanged);
    }

    private Task OnVoiceTranscript(string text)
    {
        if (string.IsNullOrWhiteSpace(_gameId)) return Task.CompletedTask;
        if (_currentUserId <= 0) return Task.CompletedTask;

        GameService.AddChatMessage(_gameId, _currentUserId, _currentUserName, VoicePrefix + text);
        return Task.CompletedTask;
    }

    private void OnVoiceMessage(string message) => _message = message;

    private void OnVoiceStatusChanged()
    {
    }

    public void Dispose()
    {
        GameService.GameUpdated -= OnGameUpdated;
        try
        {
            _uiTimer?.Dispose();
        }
        catch
        {
        }


        try
        {
            _flipAnimationCts?.Cancel();
            _flipAnimationCts?.Dispose();
            _flipAnimationCts = null;
        }
        catch
        {
        }

        _dotNetRef?.Dispose();
    }

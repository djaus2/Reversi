    private void BeginJoin(string id)
    {
        if (_currentUserId <= 0)
        {
            Nav.NavigateTo("/login", forceLoad: true);
            return;
        }
        if (_joined && _connected && string.Equals(_gameId, id, StringComparison.Ordinal))
        {
            _game = GameService.GetGame(id);
            InitializeDisplayBoardFromGame();
            _status = "";
            RefreshLegalMoves();

            GameService.GameUpdated -= OnGameUpdated;
            GameService.GameUpdated += OnGameUpdated;
            _message = GetConnectedMessage();
            return;
        }

        _status = "Joining...";
        GameService.GameUpdated -= OnGameUpdated;
        var player = GameService.TryJoinGame(id, _currentUserId, _currentUserName);
        if (player == -1)
        {
            var existing = GameService.GetActiveGameIdForUser(_currentUserId);
            if (!string.IsNullOrWhiteSpace(existing))
            {
                _status = "You are already in another game. Redirecting...";
                _connected = false;
                _joined = false;
                _ = InvokeAsync(StateHasChanged);
                Nav.NavigateTo($"/Reversi?gameId={existing}", forceLoad: false);
                return;
            }

            _status = "You are already in another game.";
            _connected = false;
            return;
        }
        if (player == 0)
        {
            Nav.NavigateTo("/", forceLoad: true);
            return;
        }
        _playerNumber = player;
        _game = GameService.GetGame(id);
        InitializeDisplayBoardFromGame();

        try
        {
            if (!string.IsNullOrWhiteSpace(_gameId) && _currentUserId > 0)
            {
                Voice.SetPreference(_gameId, _currentUserId, _preferredTtsVoiceKey, _preferredTtsLanguage, _preferredTtsRegion);
            }
        }
        catch
        {
        }

        _connected = true;
        _joined = true;
        _status = "";

        EnsureUiTimer();

        _chatDisplayStartIndex = 0;
        _chatInText = FormatChat(_game, _chatDisplayStartIndex);
        _lastChatCount = _game?.ChatMessages?.Count ?? 0;
        _lastVoiceSpokenChatIndex = _lastChatCount;
        _chatScrollPending = true;
        RefreshLegalMoves();
        GameService.GameUpdated += OnGameUpdated;
        _message = GetConnectedMessage();
        return;
    }

    private async void OnGameUpdated(string id)
    {
        if (id != _gameId) return;

        var previousGame = _game;
        _game = GameService.GetGame(id);
        ScheduleFlipAnimation();

        // Check if game was removed (became null)
        if (previousGame != null && _game == null)
        {
            // Skip the "game closed" alert if the game ended with a proper win/loss
            if (_gameEndedWithWinLoss)
            {
                // Game ended properly - no need for additional alert
                _gameEndedWithWinLoss = false; // Reset for next game
                return;
            }
        }

        RefreshLegalMoves();

        if (_game is not null)
        {
            if (_lastGameState != _game.State || _lastWinnerPlayer != _game.WinnerPlayer)
            {
                if (_game.State == ReversiService.GameState.Finished && _lastGameState != ReversiService.GameState.Finished)
                {
                    _showGameOverOverlay = true;
                    _gameOverAcknowledged = false;
                    _message = GameResultText;
                    // Mark that the game ended with a proper win/loss (not timeout/abandonment)
                    _gameEndedWithWinLoss = _game.WinnerPlayer.HasValue;
                }

                _lastGameState = _game.State;
                _lastWinnerPlayer = _game.WinnerPlayer;
            }
            
            // Additional check: If game is finished and overlay not shown, show it (unless already acknowledged)
            if (_game.State == ReversiService.GameState.Finished && !_showGameOverOverlay && !_gameOverAcknowledged)
            {
                _showGameOverOverlay = true;
                _message = GameResultText;
                _gameEndedWithWinLoss = _game.WinnerPlayer.HasValue;
            }
        }

        if (_connected
            && _game is not null
            && string.IsNullOrWhiteSpace(_message)
            && _game.State != ReversiService.GameState.Finished
            && _game.State != ReversiService.GameState.Abandoned)
        {
            _message = GetConnectedMessage();
        }

        var chatCount = _game?.ChatMessages?.Count ?? 0;
        if (chatCount != _lastChatCount)
        {
            var priorChatCount = _lastChatCount;
            _lastChatCount = chatCount;
            _chatInText = FormatChat(_game, _chatDisplayStartIndex);
            _chatScrollPending = true;

            if (_talkEnabled)
            {
                await QueueSpeakNewVoiceMessages(priorChatCount);
            }
            
            // Capture the last system message as potential game closure reason
            if (_game?.ChatMessages?.Count > 0)
            {
                var lastMsg = _game.ChatMessages[_game.ChatMessages.Count - 1];
                if (lastMsg.SenderUserId == 0 && lastMsg.SenderName == "System")
                {
                    // Capture any system message that indicates game closure or timeout
                    if (lastMsg.Text.StartsWith("Game closed:", StringComparison.OrdinalIgnoreCase) ||
                        lastMsg.Text.Contains("exceeded", StringComparison.OrdinalIgnoreCase) ||
                        lastMsg.Text.Contains("no second player joined", StringComparison.OrdinalIgnoreCase))
                    {
                        _gameClosedReason = lastMsg.Text;
                    }
                }
            }
        }

        // AI move logic for all AI modes
        if (_isAiMode && _game is not null && (_game.State == ReversiService.GameState.Connected || _game.State == ReversiService.GameState.Playing) && _game.CurrentTurn == 2)
        {
            if (!_isBoardFlipAnimationRunning)
            {
                _ = RunAiMoveAsync();
            }
        }

        await InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_chatWired)
        {
            try
            {
                _dotNetRef ??= DotNetObjectReference.Create(this);
                await JS.InvokeVoidAsync("GameChat.wireEnterToSend", _chatOutRef, _dotNetRef);
                _chatWired = true;
            }
            catch
            {
            }
        }

        if (_chatScrollPending)
        {
            try
            {
                _chatScrollPending = false;
                await JS.InvokeVoidAsync("GameChat.scrollToBottom", _chatInRef);
                await JS.InvokeVoidAsync("GameChat.scrollToBottom", _chatOutRef);
            }
            catch
            {
            }
        }

        if (firstRender)
        {
            try
            {
                await JS.InvokeAsync<bool>("GameVoice.installTtsUnlocker");
                _voiceSupported = await JS.InvokeAsync<bool>("GameVoice.isSupported");
                _voiceSupportChecked = true;
                _talkEnabled = _voiceSupported;

                try
                {
                    _isPhoneClient = await JS.InvokeAsync<bool>("GameVoice.isProbablyPhone");
                }
                catch
                {
                    _isPhoneClient = false;
                }

                if (_isPhoneClient)
                {
                    _preferredTtsVoiceKey = "";
                    _preferredTtsLanguage = "";
                    _preferredTtsRegion = "";
                    try
                    {
                        if (!string.IsNullOrWhiteSpace(_gameId) && _currentUserId > 0)
                        {
                            Voice.SetPreference(_gameId, _currentUserId, null, null, null);
                        }
                    }
                    catch
                    {
                    }
                }

                await InvokeAsync(StateHasChanged);
            }
            catch
            {
                _voiceSupported = false;
                _voiceSupportChecked = true;
            }
        }
    }

